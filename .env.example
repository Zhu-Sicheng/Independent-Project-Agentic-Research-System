# Copy to .env (gitignored) and fill in your own key.
# .env is read automatically by factorlab.config.LLMSettings.from_env();
# exported environment variables take precedence over this file.

DEEPSEEK_API_KEY=sk-your-key-here
FACTORLAB_LLM_PROVIDER=openai
FACTORLAB_LLM_BASE_URL=https://api.deepseek.com/v1
FACTORLAB_LLM_MODEL=deepseek-chat
