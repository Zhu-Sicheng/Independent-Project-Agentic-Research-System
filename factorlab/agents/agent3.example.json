{
  "agent1_run": "latest",
  "agent2_run": "latest",
  "memory_db": "research_database/research.sqlite3",
  "operator_file": "ts_operators.md",
  "output_root": "outputs/agent3",
  "mode": "offline",
  "max_expressions_per_idea": 3,
  "max_attempts_per_idea": 6,
  "max_nodes": 48,
  "max_depth": 9,
  "max_window": 252,
  "max_warmup_rows": 1000,
  "execution_lag": 1,
  "validation_max_files": 8,
  "validation_max_entities": 8,
  "min_validation_points": 30,
  "min_coverage": 0.5,
  "duplicate_correlation": 0.995,
  "preview_rows": 5000,
  "allow_unapproved_dry_run": true,
  "max_turns": 24,
  "max_tool_calls": 72,
  "memory_limit": 1000,
  "llm": {
    "base_url_env": "AGENT3_BASE_URL",
    "api_key_env": "AGENT3_API_KEY",
    "model_env": "AGENT3_MODEL",
    "auth_header": "api-key",
    "strict_tools": false,
    "max_output_tokens": 4000,
    "max_total_tokens": 160000
  }
}
