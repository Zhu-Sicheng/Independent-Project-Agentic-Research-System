      "hypothesis": "intraday_range_position_reversal",
      "attempt": 0,
      "spec": {
        "kind": "expression",
        "expression": "-rank((close - low) / max(high - low, 1e-9))",
        "script": "",
        "params": {},
        "param_grid": {},
        "explanation": "The intraday range position r = (close - low)/(high - low) measures where the close sits within the day's high-low range; near 1 means the stock closed at its high (absorbed aggressive buying), near 0 means it closed at its low (absorbed selling). Taking the cross-sectional rank makes r comparable across stocks, and the negative sign goes long low-range-position (closed near low) stocks and short high-range-position (closed near high) stocks, betting on short-horizon reversal of transient order-flow pressure over the ~5-day horizon. The max() guard prevents division blowups when high equals low.",
        "name": "",
        "notes": ""
      },
